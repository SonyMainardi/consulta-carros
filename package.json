{
  "name": "consulta-de-carros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitor local de anuncios de carros (Mercado Livre, Webmotors, OLX)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "collect": "node src/cli.js collect",
    "ml:auth": "node scripts/ml-auth.js",
    "probe:ml": "node scripts/probe/probe-ml.js",
    "probe:ml:browser": "node scripts/probe/probe-ml-browser.js",
    "probe:wm": "node scripts/probe/probe-webmotors.js",
    "probe:wm:browser": "node scripts/probe/probe-wm-browser.js",
    "probe:olx": "node scripts/probe/probe-olx.js",
    "probe:olx:browser": "node scripts/probe/probe-olx-browser.js",
    "probe": "npm run probe:ml && npm run probe:wm && npm run probe:olx",
    "ingest:fixture": "node scripts/ingest-fixture.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "playwright": "^1.63.0",
    "yaml": "^2.5.0"
  }
}
