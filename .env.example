# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=consulta_carros

# ---------- Servidor do painel ----------
PORT=3000

# ---------- Coleta ----------
# Intervalo do agendador (cron). Padrao: de hora em hora aos 7 minutos.
COLLECT_CRON=0 9 * * *
# Rodar uma coleta assim que o servidor subir?
COLLECT_ON_BOOT=false
# Intervalo minimo entre requisicoes para o MESMO host, em ms (+ jitter).
HTTP_MIN_INTERVAL_MS=60000
HTTP_JITTER_MS=20000
HTTP_TIMEOUT_MS=25000
HTTP_MAX_RETRIES=3
# Falhas consecutivas antes de desistir da fonte na rodada atual.
SOURCE_CIRCUIT_BREAKER=4

# ---------- Tetos do painel (exibicao) ----------
# O que NAO aparece na tela. Nao afeta a coleta: o anuncio continua sendo
# guardado e mantendo historico, so nao entra na lista nem nas contagens.
# 0 desliga o teto.
PANEL_PRICE_MAX=100000
PANEL_KM_MAX=100000

# ---------- Coleta via navegador real ----------
# OBRIGATORIO para as tres fontes. Sem isto o fetch do Node e barrado pelo
# fingerprint de TLS: PerimeterX no Webmotors, Cloudflare na OLX.
HTTP_USE_BROWSER=true
# NAO mude para true: headless e detectado, e alguem precisa poder resolver um
# eventual CAPTCHA na janela.
BROWSER_HEADLESS=false

# ---------- Mercado Livre ----------
# 1. Crie um app em https://developers.mercadolivre.com.br/devcenter
# 2. Cadastre a redirect URI abaixo EXATAMENTE igual no app
# 3. Marque os escopos: read e offline_access
# 4. Preencha CLIENT_ID / CLIENT_SECRET e rode: npm run ml:auth
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://localhost/callback

# Os tokens NAO vao aqui: `npm run ml:auth` salva em data/ml-tokens.json
# e o sistema renova sozinho (access token do ML vale 6h).
# As duas linhas abaixo sao so fallback manual, sem renovacao automatica.
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# ---------- Notificacoes (opcional) ----------
# Bot do Telegram: fale com @BotFather para criar e pegue o chat id com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ENABLED=false
